---
/**
 * BootSequence.astro → Intro.astro
 * Hand-drawn name writing animation with SVG stroke-dashoffset,
 * wobbly progress bar, torn-paper wipe transition.
 * Plays once per session, skippable.
 */
---

<div id="intro-overlay" class="intro-overlay">
  <div class="intro__content">
    <!-- SVG hand-writing of "Shubham Kumar Pal" -->
    <svg class="intro__signature" id="intro-sig" viewBox="0 0 700 120" fill="none" xmlns="http://www.w3.org/2000/svg">
      <!-- Wobbly handwritten path approximation -->
      <path id="sig-path" 
        d="M30,80 C35,30 45,25 55,60 C60,80 50,95 45,90 C38,82 50,40 65,45 C75,48 70,85 85,70 
           C95,58 100,50 105,55 C112,62 108,80 120,70 C128,63 130,50 140,55 C148,60 145,78 155,72 
           C162,67 165,55 175,58 C182,60 180,75 190,68 
           M210,75 C215,40 228,35 232,55 C236,72 225,85 220,80 
           M245,80 C250,55 260,50 265,65 C268,75 258,82 255,78 C250,72 262,45 275,55 C282,60 280,80 292,70 
           C300,62 305,52 312,58 C318,62 315,78 325,72 C332,67 335,55 345,58 
           M370,75 C375,35 385,30 392,55 C396,70 388,82 382,78 
           M400,82 C405,60 415,50 418,65 C420,78 412,85 408,80 
           M430,50 C430,55 430,85 430,85 M425,55 C430,52 438,52 438,55"
        stroke="#F2A623"
        stroke-width="3"
        stroke-linecap="round"
        stroke-linejoin="round"
        fill="none"
      />
    </svg>

    <p class="intro__name-text" id="intro-name-text">Shubham Kumar Pal</p>

    <!-- Wobbly progress bar -->
    <div class="intro__progress-wrap">
      <svg class="intro__progress-outline" viewBox="0 0 280 28" fill="none">
        <path d="M4,4 C6,2 12,5 20,3 C40,1 60,6 80,3 C100,1 120,5 140,4 C160,3 180,6 200,3 C220,1 240,5 260,3 C270,2 276,5 276,8 C276,12 274,20 270,22 C260,25 240,21 220,24 C200,26 180,22 160,24 C140,26 120,22 100,24 C80,26 60,22 40,24 C20,26 8,22 4,20 C2,18 2,8 4,4Z" 
          stroke="#F2A623" stroke-width="1.5" fill="none" opacity="0.5"/>
      </svg>
      <div class="intro__progress-fill" id="intro-progress-fill"></div>
      <span class="intro__progress-text" id="intro-progress-text">sketching this out...</span>
    </div>
  </div>

  <button class="intro__skip" id="intro-skip">
    <span>skip this →</span>
  </button>
</div>

<style>
  .intro-overlay {
    position: fixed;
    inset: 0;
    z-index: 10000;
    background: var(--bg-black);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transition: clip-path 0.8s cubic-bezier(0.65, 0, 0.35, 1);
    clip-path: inset(0 0 0 0);
  }

  .intro-overlay.is-tearing {
    /* Torn paper wipe — jagged clip-path transition */
    clip-path: polygon(
      0% 0%, 5% 8%, 10% 2%, 15% 10%, 20% 3%, 25% 12%, 30% 5%, 35% 15%,
      40% 4%, 45% 13%, 50% 6%, 55% 14%, 60% 3%, 65% 11%, 70% 5%, 75% 13%,
      80% 4%, 85% 12%, 90% 6%, 95% 10%, 100% 0%,
      100% 0%, 100% 0%, 0% 0%
    );
  }

  .intro-overlay.is-hidden {
    display: none;
  }

  .intro__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .intro__signature {
    width: min(500px, 85vw);
    height: auto;
    overflow: visible;
  }

  #sig-path {
    stroke-dasharray: 2000;
    stroke-dashoffset: 2000;
  }

  .intro__name-text {
    font-family: var(--font-hand);
    font-size: clamp(1.8rem, 5vw, 3rem);
    font-weight: 700;
    color: var(--accent);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.6s ease 0.3s, transform 0.6s ease 0.3s;
  }

  .intro__name-text.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .intro__progress-wrap {
    position: relative;
    width: 280px;
    height: 28px;
    margin-top: 24px;
  }

  .intro__progress-outline {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .intro__progress-fill {
    position: absolute;
    top: 6px;
    left: 10px;
    height: 16px;
    width: 0%;
    max-width: calc(100% - 20px);
    background: var(--accent);
    border-radius: 255px 15px 225px 15px / 15px 225px 15px 255px;
    opacity: 0.7;
    transition: width 0.15s linear;
  }

  .intro__progress-text {
    position: absolute;
    bottom: -24px;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-hand);
    font-size: 0.85rem;
    color: var(--text-muted-black);
    white-space: nowrap;
  }

  .intro__skip {
    position: fixed;
    bottom: 32px;
    right: 32px;
    background: none;
    border: none;
    cursor: pointer;
    z-index: 10001;
  }

  .intro__skip span {
    font-family: var(--font-hand);
    font-size: 0.95rem;
    color: var(--text-muted-black);
    transition: color 0.2s ease;
    border-bottom: 1px dashed rgba(242, 240, 235, 0.3);
    padding-bottom: 2px;
  }

  .intro__skip:hover span {
    color: var(--accent);
    border-color: var(--accent);
  }

  @media (max-width: 768px) {
    .intro__progress-wrap {
      width: 200px;
    }

    .intro__skip {
      bottom: 20px;
      right: 20px;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';

  const BOOT_KEY = 'portfolio_booted';

  function initIntro() {
    const overlay = document.getElementById('intro-overlay');
    const sigPath = document.getElementById('sig-path');
    const nameText = document.getElementById('intro-name-text');
    const progressFill = document.getElementById('intro-progress-fill');
    const skipBtn = document.getElementById('intro-skip');

    if (!overlay) return;

    // Skip if already booted this session
    if (sessionStorage.getItem(BOOT_KEY)) {
      overlay.classList.add('is-hidden');
      document.body.style.overflow = '';
      window.dispatchEvent(new CustomEvent('boot-complete'));
      return;
    }

    document.body.style.overflow = 'hidden';

    let aborted = false;
    const DURATION = 3.5; // seconds for the full animation

    // Animate the SVG signature draw
    const tl = gsap.timeline({
      onComplete: () => {
        if (!aborted) setTimeout(exitIntro, 600);
      }
    });

    tl.to(sigPath, {
      strokeDashoffset: 0,
      duration: DURATION,
      ease: 'power2.inOut',
    })
    .add(() => {
      if (nameText) nameText.classList.add('is-visible');
    }, DURATION * 0.7);

    // Progress bar fill in sync
    const startTime = performance.now();
    function animateProgress() {
      if (aborted) return;
      const elapsed = performance.now() - startTime;
      const pct = Math.min((elapsed / (DURATION * 1000)) * 100, 100);
      if (progressFill) progressFill.style.width = pct + '%';
      if (pct < 100) requestAnimationFrame(animateProgress);
    }
    requestAnimationFrame(animateProgress);

    function exitIntro() {
      if (aborted) return;
      aborted = true;
      sessionStorage.setItem(BOOT_KEY, '1');
      overlay.classList.add('is-tearing');
      setTimeout(() => {
        overlay.classList.add('is-hidden');
        document.body.style.overflow = '';
        window.dispatchEvent(new CustomEvent('boot-complete'));
      }, 800);
    }

    function skipIntro() {
      if (!aborted) {
        tl.kill();
        exitIntro();
      }
    }

    skipBtn?.addEventListener('click', skipIntro);
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay || e.target === overlay.querySelector('.intro__content')) {
        skipIntro();
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.code === 'Space' || e.code === 'Escape') skipIntro();
    });
  }

  initIntro();
</script>
