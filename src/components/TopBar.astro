---
/**
 * TopBar.astro
 * Persistent top chrome: name in black pill | rotating taglines | build progress bar
 * Matches the updated prompt's "engineer's notebook" style.
 */
---

<header id="top-bar" class="top-bar">
  <div class="top-bar__name">
    <span>Shubham Kumar Pal</span>
  </div>
  <div class="top-bar__tagline" id="top-bar-tagline">
    <span class="tagline-text" id="tagline-text">Built this site myself. No Figma, just vibes and Tailwind.</span>
  </div>
  <div class="top-bar__progress-area">
    <span class="top-bar__progress-bar" id="progress-bar">[░░░░░░░░] 0%</span>
  </div>
</header>

<style>
  .top-bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 48px;
    padding: 0 20px;
    background: rgba(10, 10, 10, 0.88);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(242, 240, 235, 0.06);
  }

  .top-bar__name {
    flex-shrink: 0;
  }

  .top-bar__name span {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 600;
    color: #fff;
    background: #111;
    padding: 5px 16px;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(242, 240, 235, 0.12);
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .top-bar__tagline {
    flex: 1;
    text-align: center;
    font-family: var(--font-body);
    font-size: 0.72rem;
    color: rgba(242, 240, 235, 0.5);
    font-style: italic;
    overflow: hidden;
    padding: 0 20px;
    white-space: nowrap;
  }

  .tagline-text {
    display: inline-block;
    transition: opacity 0.4s ease, transform 0.4s ease;
  }

  .tagline-text.is-fading {
    opacity: 0;
    transform: translateY(-6px);
  }

  .top-bar__progress-area {
    flex-shrink: 0;
  }

  .top-bar__progress-bar {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--accent);
    letter-spacing: 0.03em;
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .top-bar {
      padding: 0 12px;
      height: 42px;
    }

    .top-bar__tagline {
      display: none;
    }

    .top-bar__progress-bar {
      font-size: 0.65rem;
    }

    .top-bar__name span {
      font-size: 0.7rem;
      padding: 4px 12px;
    }
  }
</style>

<script>
  const taglines = [
    "Built this site myself. No Figma, just vibes and Tailwind.",
    "console.log('please don't check my commit messages')",
    "Deployed more times today than I've had chai.",
    "This site has better uptime than my sleep schedule.",
    "Currently solving: your business problem. Previously solved: five of them.",
    "Yes, I tested this in production. No, I'm not sorry.",
    "Built with more coffee than documentation.",
  ];

  let currentTagline = 0;
  const taglineEl = document.getElementById('tagline-text');

  function rotateTagline() {
    if (!taglineEl) return;
    taglineEl.classList.add('is-fading');
    setTimeout(() => {
      currentTagline = (currentTagline + 1) % taglines.length;
      taglineEl.textContent = taglines[currentTagline];
      taglineEl.classList.remove('is-fading');
    }, 400);
  }

  setInterval(rotateTagline, 4500);

  // Build progress bar — styled like "[████░░░░] 62% compiled"
  const progressBar = document.getElementById('progress-bar');
  const TOTAL_BLOCKS = 8;

  function updateProgress() {
    const scrollTop = window.scrollY;
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    const pct = docHeight > 0 ? Math.min(Math.round((scrollTop / docHeight) * 100), 100) : 0;
    const filled = Math.round((pct / 100) * TOTAL_BLOCKS);
    const empty = TOTAL_BLOCKS - filled;
    const bar = '█'.repeat(filled) + '░'.repeat(empty);
    if (progressBar) {
      progressBar.textContent = `[${bar}] ${pct}% compiled`;
    }
  }

  window.addEventListener('scroll', updateProgress, { passive: true });
  updateProgress();
</script>
