---
/**
 * Hero.astro — HOME section
 * Black background. Handwritten headline with word-by-word stagger reveal.
 * Amber wobbly underline on "running systems", sticky note, doodled arrows,
 * tech badges on torn-paper chips, cursor-follow glow.
 */
---

<section id="home" class="hero section--black">
  <!-- Cursor-follow glow -->
  <div class="hero__glow" id="hero-glow"></div>

  <div class="hero__content container">
    <!-- Sticky note -->
    <div class="hero__sticky-note" id="hero-sticky">
      <div class="tape"></div>
      <span>shipping since 2025</span>
    </div>

    <h1 class="hero__title" id="hero-title">
      <span class="hero__word">I</span>
      <span class="hero__word">don't</span>
      <span class="hero__word">just</span>
      <span class="hero__word">write</span>
      <span class="hero__word">code</span>
      <span class="hero__word">—</span>
      <br/>
      <span class="hero__word">I</span>
      <span class="hero__word">turn</span>
      <span class="hero__word">business</span>
      <span class="hero__word">problems</span>
      <span class="hero__word">into</span>
      <span class="hero__word hero__word--underlined">
        running
        <svg class="hero__squiggle" viewBox="0 0 120 12" preserveAspectRatio="none">
          <path d="M2,8 C10,2 20,12 30,6 C40,1 50,11 60,5 C70,0 80,10 90,6 C100,2 110,10 118,5" 
            fill="none" stroke="#F2A623" stroke-width="3" stroke-linecap="round" id="hero-underline-1"/>
        </svg>
      </span>
      <span class="hero__word hero__word--underlined">
        systems.
        <svg class="hero__squiggle hero__squiggle--2" viewBox="0 0 130 12" preserveAspectRatio="none">
          <path d="M2,6 C12,1 22,11 32,5 C42,0 52,10 62,4 C72,0 82,11 92,6 C102,1 112,10 122,4 L128,6" 
            fill="none" stroke="#F2A623" stroke-width="3" stroke-linecap="round" id="hero-underline-2"/>
        </svg>
      </span>
    </h1>

    <p class="hero__sub" id="hero-sub">
      Odoo · FastAPI · Next.js · Python — from ERP workflows to SaaS that people actually pay to use.
    </p>

    <!-- Tech badges on torn-paper chips -->
    <div class="hero__badges" id="hero-badges">
      <span class="hero__badge-chip" style="--rot: -3deg">Odoo</span>
      <span class="hero__badge-chip" style="--rot: 2deg">Python</span>
      <span class="hero__badge-chip" style="--rot: -1deg">Next.js</span>
      <span class="hero__badge-chip" style="--rot: 4deg">FastAPI</span>
    </div>

    <!-- Doodled arrows (SVG) -->
    <svg class="hero__doodle-arrow hero__doodle-arrow--1" viewBox="0 0 60 40" fill="none">
      <path d="M5,30 C15,28 25,15 45,10 M45,10 L38,8 M45,10 L42,16" stroke="#F2A623" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0.5"/>
    </svg>
    <svg class="hero__doodle-arrow hero__doodle-arrow--2" viewBox="0 0 50 50" fill="none">
      <path d="M5,5 C20,8 35,20 40,40 M40,40 L36,33 M40,40 L33,38" stroke="#F2A623" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0.5"/>
    </svg>

    <!-- Scroll-down hand-drawn arrow -->
    <div class="hero__scroll-cue" id="hero-scroll-cue">
      <svg width="24" height="40" viewBox="0 0 24 40" fill="none">
        <path d="M12,2 L12,32 M12,32 C10,28 6,26 4,24 M12,32 C14,28 18,26 20,24" 
          stroke="#F2A623" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0.6"/>
      </svg>
      <span class="hero__scroll-label">scroll down</span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 120px 0 80px;
    overflow: hidden;
  }

  .hero__glow {
    position: fixed;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--accent-glow) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
    opacity: 0;
    transform: translate(-50%, -50%);
    transition: opacity 0.3s ease;
    will-change: left, top;
  }

  .hero__content {
    position: relative;
    z-index: 1;
    width: 100%;
  }

  /* Sticky note */
  .hero__sticky-note {
    position: absolute;
    top: -20px;
    right: 40px;
    background: #FFF8DC;
    color: #333;
    padding: 12px 18px;
    font-family: var(--font-hand);
    font-size: 0.95rem;
    font-weight: 400;
    transform: rotate(-3deg);
    box-shadow: var(--shadow-sticky);
    border-radius: 2px;
    opacity: 0;
    z-index: 2;
  }

  /* Title */
  .hero__title {
    font-family: var(--font-hand);
    font-size: clamp(2.2rem, 5.5vw, 4.2rem);
    font-weight: 700;
    color: var(--text-on-black);
    line-height: 1.2;
    margin-bottom: 24px;
    max-width: 800px;
  }

  .hero__word {
    display: inline-block;
    opacity: 0;
    transform: translateY(20px);
    margin-right: 0.2em;
  }

  .hero__word--underlined {
    position: relative;
    color: var(--accent);
  }

  .hero__squiggle {
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 100%;
    height: 12px;
    overflow: visible;
  }

  .hero__squiggle path {
    stroke-dasharray: 200;
    stroke-dashoffset: 200;
  }

  /* Sub */
  .hero__sub {
    font-family: var(--font-body);
    font-size: clamp(0.9rem, 1.6vw, 1.1rem);
    color: var(--text-muted-black);
    max-width: 600px;
    margin-bottom: 32px;
    opacity: 0;
    transform: translateY(12px);
  }

  /* Tech badges on torn-paper chips */
  .hero__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 48px;
    opacity: 0;
  }

  .hero__badge-chip {
    font-family: var(--font-hand);
    font-size: 0.85rem;
    font-weight: 400;
    color: #333;
    background: #FFF8DC;
    padding: 6px 14px;
    border-radius: 255px 12px 225px 12px / 12px 225px 12px 255px;
    transform: rotate(var(--rot, 0deg));
    box-shadow: var(--shadow-sticky);
    border: 1px solid rgba(0,0,0,0.06);
    position: relative;
  }

  /* Doodle arrows */
  .hero__doodle-arrow {
    position: absolute;
    opacity: 0;
  }

  .hero__doodle-arrow--1 {
    width: 60px;
    top: 55%;
    right: 15%;
  }

  .hero__doodle-arrow--2 {
    width: 50px;
    bottom: 25%;
    right: 25%;
  }

  /* Scroll cue */
  .hero__scroll-cue {
    position: absolute;
    bottom: 32px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    opacity: 0;
    animation: bounce-cue 2.5s ease-in-out infinite;
    animation-play-state: paused;
  }

  .hero__scroll-cue.is-visible {
    animation-play-state: running;
  }

  .hero__scroll-label {
    font-family: var(--font-hand);
    font-size: 0.75rem;
    color: var(--text-muted-black);
  }

  @keyframes bounce-cue {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(6px); }
  }

  @media (max-width: 768px) {
    .hero {
      padding: 100px 0 60px;
    }

    .hero__sticky-note {
      position: relative;
      top: auto;
      right: auto;
      margin-bottom: 24px;
      display: inline-block;
    }

    .hero__doodle-arrow {
      display: none;
    }

    .hero__title {
      font-size: clamp(1.8rem, 7vw, 2.8rem);
    }

    .hero__glow {
      display: none;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';

  function initHero() {
    // Cursor-follow glow
    const glow = document.getElementById('hero-glow');
    if (glow && window.innerWidth > 768) {
      document.addEventListener('mousemove', (e) => {
        glow.style.left = e.clientX + 'px';
        glow.style.top = e.clientY + 'px';
        glow.style.opacity = '0.25';
      });
    }

    function playHeroAnim() {
      const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

      // Sticky note
      tl.to('.hero__sticky-note', { opacity: 1, duration: 0.5 });

      // Word-by-word reveal
      const words = document.querySelectorAll('.hero__word');
      words.forEach((word, i) => {
        tl.to(word, {
          opacity: 1,
          y: 0,
          duration: 0.4,
        }, 0.3 + i * 0.08);
      });

      // Wobbly underlines draw
      tl.to('#hero-underline-1', {
        strokeDashoffset: 0,
        duration: 0.6,
        ease: 'power2.inOut',
      }, '-=0.2');

      tl.to('#hero-underline-2', {
        strokeDashoffset: 0,
        duration: 0.6,
        ease: 'power2.inOut',
      }, '-=0.4');

      // Sub text
      tl.to('#hero-sub', { opacity: 1, y: 0, duration: 0.5 }, '-=0.3');

      // Badges
      tl.to('.hero__badges', { opacity: 1, duration: 0.5 }, '-=0.2');

      // Doodle arrows
      tl.to('.hero__doodle-arrow', { opacity: 1, duration: 0.4, stagger: 0.15 }, '-=0.3');

      // Scroll cue
      tl.to('#hero-scroll-cue', {
        opacity: 1,
        duration: 0.4,
        onComplete: () => {
          document.getElementById('hero-scroll-cue')?.classList.add('is-visible');
        }
      }, '-=0.1');
    }

    if (sessionStorage.getItem('portfolio_booted')) {
      playHeroAnim();
    } else {
      window.addEventListener('boot-complete', () => setTimeout(playHeroAnim, 200));
    }
  }

  initHero();
</script>
