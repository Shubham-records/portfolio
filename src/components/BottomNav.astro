---
/**
 * BottomNav.astro
 * Persistent bottom nav pill with scroll-spy. Amber active state.
 * Links: Home / Origin / Projects / Best Work / Contact
 */
---

<nav id="bottom-nav" class="bottom-nav" aria-label="Section navigation">
  <div class="bottom-nav__inner">
    <a href="#home" class="bottom-nav__link is-active" data-section="home">Home</a>
    <a href="#origin" class="bottom-nav__link" data-section="origin">Origin</a>
    <a href="#projects" class="bottom-nav__link" data-section="projects">Projects</a>
    <a href="#best-work" class="bottom-nav__link" data-section="best-work">Best Work</a>
    <a href="#contact" class="bottom-nav__link" data-section="contact">Contact</a>
  </div>
</nav>

<style>
  .bottom-nav {
    position: fixed;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1000;
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
  }

  .bottom-nav.is-visible {
    opacity: 1;
    pointer-events: auto;
  }

  .bottom-nav__inner {
    display: flex;
    align-items: center;
    background: rgba(10, 10, 10, 0.9);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(242, 240, 235, 0.1);
    border-radius: var(--radius-pill);
    padding: 5px 6px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
  }

  .bottom-nav__link {
    font-family: var(--font-hand);
    font-size: 0.85rem;
    font-weight: 700;
    color: rgba(242, 240, 235, 0.6);
    padding: 8px 18px;
    border-radius: var(--radius-pill);
    transition: all 0.3s ease;
    white-space: nowrap;
    text-decoration: none;
    cursor: pointer;
    user-select: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .bottom-nav__link:hover {
    color: var(--text-on-black);
    background: rgba(242, 240, 235, 0.05);
  }

  .bottom-nav__link.is-active {
    color: var(--bg-black);
    background: var(--accent);
  }

  @media (max-width: 768px) {
    .bottom-nav {
      bottom: 12px;
      left: 8px;
      right: 8px;
      transform: none;
    }

    .bottom-nav__inner {
      width: 100%;
      justify-content: space-around;
      padding: 4px;
    }

    .bottom-nav__link {
      font-size: 0.72rem;
      padding: 8px 10px;
    }
  }

  @media (max-width: 420px) {
    .bottom-nav__link {
      font-size: 0.65rem;
      padding: 7px 7px;
    }
  }
</style>

<script>
  function initBottomNav() {
    const nav = document.getElementById('bottom-nav');
    const links = document.querySelectorAll('.bottom-nav__link');
    const sectionIds = ['home', 'origin', 'projects', 'best-work', 'contact'];

    if (!nav) return;

    function showNav() {
      nav.classList.add('is-visible');
    }

    window.addEventListener('boot-complete', showNav);
    if (sessionStorage.getItem('portfolio_booted')) {
      showNav();
    } else {
      setTimeout(showNav, 5000);
    }

    // Smooth scroll via Lenis
    links.forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const targetId = link.getAttribute('data-section');
        const target = document.getElementById(targetId);
        if (target && window.lenis) {
          window.lenis.scrollTo(target, { offset: -48 });
        } else if (target) {
          target.scrollIntoView({ behavior: 'smooth' });
        }
      });
    });

    // Scroll spy
    function updateActiveLink() {
      const scrollY = window.scrollY + window.innerHeight / 3;
      let activeId = sectionIds[0];
      for (const id of sectionIds) {
        const section = document.getElementById(id);
        if (section && section.offsetTop <= scrollY) {
          activeId = id;
        }
      }
      links.forEach(link => {
        link.classList.toggle('is-active', link.getAttribute('data-section') === activeId);
      });
    }

    window.addEventListener('scroll', updateActiveLink, { passive: true });
    updateActiveLink();
  }

  initBottomNav();
</script>
