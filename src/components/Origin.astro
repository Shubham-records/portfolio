---
/**
 * Origin.astro — "how I got here" notebook diary pages
 * Cream/off-white background. Pinned on desktop with 3D page-tilt on scroll.
 * Squiggle connector drawn progressively. Mobile: simple fade-ups.
 */
---

<section id="origin" class="origin section--cream">
  <div class="origin__header container">
    <h2 class="origin__title" id="origin-title">
      how I got here
      <svg class="origin__title-squiggle" viewBox="0 0 200 10" preserveAspectRatio="none">
        <path d="M2,6 Q20,2 40,7 T80,5 T120,7 T160,4 T198,6" fill="none" stroke="#F2A623" stroke-width="2.5" stroke-linecap="round"/>
      </svg>
    </h2>
  </div>

  <div class="origin__pages-wrap container" id="origin-pages-wrap">
    <!-- Squiggle connector SVG -->
    <svg class="origin__connector" viewBox="0 0 40 800" preserveAspectRatio="none" id="origin-connector-svg">
      <path id="origin-connector" 
        d="M20,0 C25,40 15,80 20,120 C25,160 10,200 20,240 C30,280 15,320 20,360 C25,400 10,440 20,480 C30,520 15,560 20,600 C25,640 15,680 20,720 C25,760 15,790 20,800"
        fill="none" stroke="#F2A623" stroke-width="2.5" stroke-linecap="round"
        stroke-dasharray="1200" stroke-dashoffset="1200"/>
    </svg>

    <!-- Diary page 1 -->
    <div class="origin__page" data-page="1" id="origin-page-1">
      <div class="origin__page-inner">
        <div class="pushpin"></div>
        <h3 class="origin__page-heading">The curiosity spark</h3>
        <p class="origin__page-body">
          Started tinkering with code not because someone told me to, but because I wanted to understand how things worked. Broke things. Fixed things. Broke more things. That was the whole curriculum.
        </p>
      </div>
    </div>

    <!-- Diary page 2 -->
    <div class="origin__page" data-page="2" id="origin-page-2">
      <div class="origin__page-inner" style="--tilt: 2deg">
        <div class="tape" style="left: auto; right: 16px; transform: rotate(5deg);"></div>
        <h3 class="origin__page-heading">Building with purpose</h3>
        <p class="origin__page-body">
          Realized that writing code isn't just about making things run — it's about making things matter. Every line is a decision. Every project, a small bet on what the world needs.
        </p>
      </div>
    </div>

    <!-- Timeline thread between pages -->
    <div class="origin__timeline" id="origin-timeline">
      <div class="origin__timeline-item"><span class="origin__tl-date">Jan 2025</span><span class="origin__tl-text">Joined Odiware as an intern</span></div>
      <div class="origin__timeline-item"><span class="origin__tl-date">+2 months</span><span class="origin__tl-text">Already shipping fixes solo</span></div>
      <div class="origin__timeline-item"><span class="origin__tl-date">+4 months</span><span class="origin__tl-text">Handling client work directly</span></div>
      <div class="origin__timeline-item"><span class="origin__tl-date">Aug 2025</span><span class="origin__tl-text">Converted to full-time</span></div>
      <div class="origin__timeline-item"><span class="origin__tl-date">Sep 2025</span><span class="origin__tl-text">Led an ERP build for an international HVAC-upgrade services client</span></div>
      <div class="origin__timeline-item"><span class="origin__tl-date">Since</span><span class="origin__tl-text">Scaled up to a government-integrated solar installation platform for a utility client</span></div>
    </div>

    <!-- Diary page 3 -->
    <div class="origin__page" data-page="3" id="origin-page-3">
      <div class="origin__page-inner" style="--tilt: -1deg">
        <div class="pushpin" style="right: auto; left: 16px;"></div>
        <h3 class="origin__page-heading">Shipping is the habit</h3>
        <p class="origin__page-body">
          Odoo modules, solar portals, CRM systems, creative tools — I stopped waiting for permission and started shipping. Ugly v1s that turned into solid products used by real people, every day.
        </p>
      </div>
    </div>

    <!-- Closing quote -->
    <div class="origin__closing" id="origin-closing">
      <p class="origin__closing-text">
        "If I ever write a book on how I see building things, it will have infinite pages. And I'll still be figuring it out."
      </p>
    </div>
  </div>
</section>

<style>
  .origin {
    position: relative;
    padding: 120px 0 80px;
  }

  .origin__header {
    text-align: center;
    margin-bottom: 64px;
  }

  .origin__title {
    font-family: var(--font-hand);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    color: var(--text-on-cream);
    position: relative;
    display: inline-block;
    opacity: 0;
    transform: translateY(16px);
  }

  .origin__title-squiggle {
    position: absolute;
    bottom: -6px;
    left: 0;
    width: 100%;
    height: 10px;
  }

  .origin__pages-wrap {
    position: relative;
    max-width: 680px;
    margin: 0 auto;
    padding-left: 52px;
  }

  .origin__connector {
    position: absolute;
    left: 16px;
    top: 0;
    width: 40px;
    height: 100%;
    z-index: 0;
  }

  /* Diary pages */
  .origin__page {
    position: relative;
    margin-bottom: 48px;
    z-index: 1;
    opacity: 0;
    transform: translateY(30px);
  }

  .origin__page-inner {
    position: relative;
    background: #fff;
    border: 1px solid rgba(0,0,0,0.08);
    padding: 28px 28px 24px;
    border-radius: 3px;
    box-shadow: var(--shadow-card);
    transform: rotate(var(--tilt, -1deg));
    transition: transform 0.4s ease, box-shadow 0.4s ease;
  }

  .origin__page-inner:hover {
    box-shadow: var(--shadow-card-hover);
    transform: rotate(0deg) translateY(-2px);
  }

  .origin__page-heading {
    font-family: var(--font-hand);
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--text-on-cream);
    margin-bottom: 10px;
  }

  .origin__page-body {
    font-family: var(--font-body);
    font-size: 0.92rem;
    color: rgba(26, 26, 26, 0.7);
    line-height: 1.75;
  }

  /* Timeline thread */
  .origin__timeline {
    position: relative;
    z-index: 1;
    margin: 16px 0 48px;
    padding-left: 8px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    opacity: 0;
    transform: translateY(20px);
  }

  .origin__timeline-item {
    display: flex;
    gap: 14px;
    align-items: baseline;
    padding: 8px 16px;
    background: rgba(242, 166, 35, 0.08);
    border-left: 3px solid var(--accent);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .origin__tl-date {
    font-family: var(--font-hand);
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--accent);
    white-space: nowrap;
    min-width: 80px;
  }

  .origin__tl-text {
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--text-on-cream);
  }

  /* Closing */
  .origin__closing {
    text-align: center;
    padding: 32px 0 0;
    opacity: 0;
    transform: translateY(16px);
  }

  .origin__closing-text {
    font-family: var(--font-hand);
    font-size: 1rem;
    font-style: italic;
    color: var(--text-muted-cream);
    line-height: 1.8;
    max-width: 500px;
    margin: 0 auto;
  }

  @media (max-width: 768px) {
    .origin {
      padding: 80px 0 60px;
    }

    .origin__pages-wrap {
      padding-left: 0;
    }

    .origin__connector {
      display: none;
    }

    .origin__page-inner {
      transform: rotate(0deg);
      padding: 20px;
    }

    .origin__header {
      margin-bottom: 40px;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  function initOrigin() {
    const isMobile = window.innerWidth < 768;

    // Title
    gsap.to('.origin__title', {
      opacity: 1, y: 0, duration: 0.7,
      scrollTrigger: { trigger: '.origin__header', start: 'top 80%' },
    });

    // Squiggle connector draw
    if (!isMobile) {
      ScrollTrigger.create({
        trigger: '#origin-pages-wrap',
        start: 'top 70%',
        end: 'bottom 30%',
        onUpdate: (self) => {
          const path = document.getElementById('origin-connector');
          if (path) {
            path.style.strokeDashoffset = String(1200 - (self.progress * 1200));
          }
        },
      });
    }

    // Pages reveal
    const pages = document.querySelectorAll('.origin__page');
    pages.forEach(page => {
      gsap.to(page, {
        opacity: 1, y: 0, duration: 0.7,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: page,
          start: 'top 85%',
          toggleActions: 'play none none reverse',
        },
      });
    });

    // Timeline
    gsap.to('.origin__timeline', {
      opacity: 1, y: 0, duration: 0.6,
      scrollTrigger: { trigger: '.origin__timeline', start: 'top 85%' },
    });

    // Closing
    gsap.to('.origin__closing', {
      opacity: 1, y: 0, duration: 0.7,
      scrollTrigger: { trigger: '.origin__closing', start: 'top 90%' },
    });
  }

  initOrigin();
</script>
